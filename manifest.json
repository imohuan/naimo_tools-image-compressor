{
  "$schema": "./schema.json",
  "id": "image-compressor",
  "name": "图片压缩工具",
  "version": "1.0.1",
  "author": "Naimo Team",
  "icon": "./ico.png",
  "description": "本地图片压缩工具，支持批量处理、格式转换、实时预览对比",
  "category": "image_video",
  "enabled": true,
  "main": "./index.html",
  "preload": "./preload.js",
  "feature": [
    {
      "path": "compress",
      "name": "图片压缩",
      "icon": "./ico.png",
      "description": "本地极速压缩图片，支持批量处理和格式转换",
      "weight": 100
    },
    {
      "path": "compress-from-image",
      "name": "当前图片压缩",
      "icon": "./ico.png",
      "description": "当前图片压缩",
      "type": "img",
      "weight": 100
    }
  ]
}